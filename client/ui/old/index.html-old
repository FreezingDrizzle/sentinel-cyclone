<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="styles.css" />
    <title>Sentinel Mixer</title>
  </head>
  <body>
    <main>
      <h1>Sentinel Mixer</h1>

      <section class="card">
        <h2>Wallet</h2>
        <div class="row">
          <button id="btnNew">Create new</button>
          <button id="btnLoad">Load seed</button>
        </div>
        <textarea id="seed" rows="2" placeholder="12/24-word seed phrase"></textarea>
        <div id="addr" class="mono muted"></div>
      </section>

      <section class="card">
        <h2>Mix</h2>
        <label>Denomination
          <select id="tier">
            <option value="small">100 DVPN</option>
            <option value="medium">500 DVPN</option>
            <option value="large">1000 DVPN</option>
          </select>
        </label>
        <div class="row">
          <label>Input index <input id="inIdx" type="number" value="0" min="0" /></label>
          <label>Output index <input id="outIdx" type="number" value="1" min="1" /></label>
        </div>
        <button id="btnMix" class="primary">Start mix</button>
      </section>

      <section class="card">
        <h2>Log</h2>
        <pre id="log" class="log"></pre>
      </section>
    </main>
    <script src="renderer.js"></script>
  </body>
</html>
